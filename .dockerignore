# Build artifacts — never ship these into image layers
target
src-tauri/target
src-tauri/gen

# Node deps — rebuilt in the frontend stage
node_modules
dist

# Git & IDE metadata
.git
.gitignore
.vscode
.idea
*.swp

# Test artifacts
test-results
playwright-report
tests/e2e/.playwright-cache

# Local settings & scratch
.env
.env.local
*.log
.DS_Store

# Existing docker files don't need to enter their own build context
docker-compose*.yml
Dockerfile
.dockerignore

# Planning / docs / specs — not needed at runtime
docs
.planning
